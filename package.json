{
  "name": "brain-agent-app",
  "version": "1.0.0",
  "description": "Brain extension for Agent AI: long-term memory, RAG, and project context management for Grafana AI agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/luiscorreiaOps/brain-agent-app.git"
  },
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache ./src",
    "lint:fix": "eslint --cache --fix --ext .js,.jsx,.ts,.tsx ./src",
    "backend:build": "mage -v",
    "server": "docker compose up --build",
    "sign": "sign-plugin"
  },
  "author": "Luis Correia",
  "license": "MIT",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.11.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer": "^25.9.0",
    "imports-loader": "^5.0.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.0",
    "terser-webpack-plugin": "^5.3.0",
    "typescript": "5.9.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "dependencies": {
    "@emotion/css": "^11.13.0",
    "@grafana/data": "^12.3.0",
    "@grafana/runtime": "^12.3.0",
    "@grafana/ui": "^12.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7",
  "overrides": {
    "dompurify": "^3.4.14",
    "fast-uri": "^3.1.5",
    "immutable": "^5.1.9",
    "js-cookie": "^3.0.8",
    "js-yaml": "^4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "^5.0.9"
    },
    "nanoid": "^3.3.18",
    "react-router": "^8.3.1",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
