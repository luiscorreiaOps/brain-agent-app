{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Brain Agent",
  "id": "brain-agent",
  "backend": true,
  "executable": "gpx_brain-agent",
  "preload": true,
  "info": {
    "keywords": ["ai", "memory", "rag", "grafana"],
    "description": "Brain extension for Agent AI: Long-term memory, RAG, and project context management.",
    "author": {
      "name": "Luis Correia"
    },
    "logos": {
      "small": "img/brain-logo.png",
      "large": "img/brain-logo.png"
    },
    "links": [
      { "name": "Website", "url": "https://github.com/luiscorreiaOps/brain-agent-app" },
      { "name": "License", "url": "https://github.com/luiscorreiaOps/brain-agent-app/blob/main/LICENSE" }
    ],
    "screenshots": [
      { "name": "Brain Hub", "path": "img/screenshots/brain-hub.png" },
      { "name": "Structured memory & pending suggestions", "path": "img/screenshots/structured-memory-and-suggestions.png" },
      { "name": "Configuration", "path": "img/screenshots/configuration-page.png" }
    ],
    "version": "1.0.0",
    "updated": "2026-08-18"
  },
  "includes": [
    {
      "type": "page",
      "name": "Brain Hub",
      "path": "/a/brain-agent/hub",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Configuration",
      "path": "/plugins/brain-agent",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": []
  }
}
